# Supabase (çok oyunculu mod için — Vercel projesinde de aynı isimlerle tanımlanır)
# Project Settings → API anahtarları
VITE_SUPABASE_URL=https://<proje-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# Taşıyıcıyı elle seçmek isterseniz: ws (yerel sunucu) | cloud (Supabase Realtime)
# VITE_TRANSPORT=cloud
